    <section class="contact">
        <div class="content">
            <h2>Contact us</h2>
            <p>please contact us if you have any problem you can message us or you contact us<br> Details are given below</p>
        </div>
        <div class="container">
            <div class="contactInfo">
                <div class="box">
                    <div class="icon"><i class="fa fa-map-marker" aria-hidden="true"></i></div>
                    <div class="text">
                        <h3>Address</h3>
                        <p>Kota Bharath,<br>Kothapalem,<br>Jaladanki Mandal,<br>Nellore District,<br>Andhra Pradesh - 524223.</p>
                    </div>
                </div>
                <div class="box">
                    <div class="icon"><i class="fa fa-envelope" aria-hidden="true"></i></div>
                    <div class="text">
                        <h3>Email</h3>
                        <p>contact@onlineexam.com</p>
                    </div>

                </div>
                <div class="box">
                    <div class="icon"><i class="fa fa-mobile" aria-hidden="true"></i></div>
                    <div class="text">

                        <h3>Phone</h3>
                        <p>+91 8919483384</p>
                    </div>
                </div>

                <div class="social-media">
                    <p>Connect with us :</p>
                    <div class="social-icons">
                        <a href="#">
                            <i class="fab fa-facebook-f" aria-hidden="true"></i>
                        </a>
                        <a href="#">
                            <i class="fab fa-twitter" aria-hidden="true"></i>
                        </a>
                        <a href="#">
                            <i class="fab fa-instagram" aria-hidden="true"></i>
                        </a>

                        <a href="#">
                            <i class="fab fa-youtube" aria-hidden="true"></i>
                        </a>
                        <a href="#">
                            <i class="fab fa-snapchat" aria-hidden="true"></i>
                        </a>
                    </div>

                </div>


            </div>
            <div class="contactform">
                <h2>Please send your message below</h2>

                <form action="/contactus" id="form" method="post" name="form" onsubmit="return validateform()">

                    <div class="formbox">
                        <div class="inputbox w50">
                            <input type="text" name="name" required>
                            <span>Full Name</span>
                        </div>
                        <div class="inputbox w50">
                            <input type="email" name="email" required>
                            <span>Email Address</span>
                        </div>
                        <div class="inputbox w50">
                            <input type="text" name="phone" required>
                            <span>Mobile Number</span>
                        </div>
                        <div class="inputbox w500">
                            <textarea name="message" required></textarea>
                            <span>Write your Message..</span>
                        </div>
                        <div class="inputboxsubmit">
                            <input type="submit" value="Send">
                        </div>

                    </div>


                </form>

            </div>
        </div>
    </section>

    <script>
        function validateform() {
            var name = document.form.email.value;
            var atposition = name.indexOf("@");
            var dotposition = name.lastIndexOf(".");
            if (atposition < 1 || dotposition < atposition + 2 || dotposition + 2 >= name.length) {
                alert("Please enter a valid e-mail address \n atpostion:" + atposition + "\n dotposition:" + dotposition);
                return false;
            } else if (name == null || name == "") {
                alert("Email can't be blank");
                return false;
            }
        }
    </script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-ka7Sk0Gln4gmtz2MlQnikT1wXgYsOg+OMhuP+IlRH9sENBO0LRn5q+8nbTov4+1p" crossorigin="anonymous"></script>

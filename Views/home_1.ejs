    <br><br>

    <div id="notification-toast">
        <div class="toast-content">
            <div class="toast-icon"><i class='bx bxs-bell-ring'></i></div>
            <div class="toast-text" id="notification-message">New update available!</div>
            <div class="toast-close" onclick="closeToast()"><i class='bx bx-x'></i></div>
        </div>
    </div>

    <!-- Option 1: Bootstrap Bundle with Popper -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-ka7Sk0Gln4gmtz2MlQnikT1wXgYsOg+OMhuP+IlRH9sENBO0LRn5q+8nbTov4+1p" crossorigin="anonymous"></script>

    <script>
        // --- Socket.io Real-time Notifications ---
        const socket = io();

        socket.on('new-achievement', (data) => {
            showToast(`🔥 <b>${data.username}</b> just scored <b>${data.score}%</b> in ${data.exam}!`);
        });

        socket.on('new-question', (data) => {
            showToast(`🚀 New questions added to <b>${data.exam}</b>. Check them out!`);
        });

        function showToast(message) {
            const toast = document.getElementById('notification-toast');
            const msgEl = document.getElementById('notification-message');
            msgEl.innerHTML = message;
            toast.style.display = 'block';
            
            // Auto-hide after 8 seconds
            setTimeout(closeToast, 8000);
        }

        function closeToast() {
            document.getElementById('notification-toast').style.display = 'none';
        }

        // --- Existing Theme/Color Logic ---
        let colors = ['black', 'green', 'orange', 'red']
        let index = 0;

        function changeColor() {
            const h4 = document.getElementById('h4');
            if (h4) {
                h4.style.setProperty('color', colors[index++]);
                index %= colors.length;
            }
        }

        let interval = setInterval(changeColor, 1000);
    </script>
